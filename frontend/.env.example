# URL of the FastAPI backend. If you're running the backend via
# docker-compose, this is exposed on localhost:8000 by default.
VITE_API_BASE_URL=http://localhost:8000

# Optional. Same Google OAuth Client ID as the backend's GOOGLE_CLIENT_ID.
# Leave unset and the "Sign in with Google" button just won't render.
VITE_GOOGLE_CLIENT_ID=
